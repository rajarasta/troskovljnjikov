# Environment & Debug Mode
DEBUG=false
AUTH_ENABLED=false  # Set to true to require API key authentication

# Claude API Configuration for Price Search
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Override model for price search agent
# LLM_MODEL_NAME=claude-sonnet-4-5-20250929

# Database configuration
DATABASE_URL=sqlite:///./data/boq.db

# CORS settings (adjust for your deployment)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Upload limits (in MB)
MAX_UPLOAD_SIZE_MB=50

# RAG/Matching settings
MATCH_THRESHOLD=0.3
MAX_MATCH_RESULTS=20
